# Release image for the two SPAs: admin at /, customer at /customer/.
#
# ponytail: the sibling Dockerfile copies dists built on the host, because npm
# registry fetches stall inside containers on the developer's machine. A CI
# runner has no such problem, so the release image builds properly in-container
# and a release never depends on what happened to be in frontend-*/dist.
# Both stages are built from the repository root, which is why the COPY paths
# carry the frontend-* prefix.

FROM node:20-alpine AS admin
WORKDIR /app
COPY frontend-admin/package.json frontend-admin/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend-admin/ ./
RUN npm run build

FROM node:20-alpine AS customer
WORKDIR /app
# The customer app is served under a sub-path, so Vite has to bake that prefix
# into every asset URL; a root-path build 404s on its own JavaScript.
ENV VITE_BASE_PATH=/customer/
COPY frontend-customer/package.json frontend-customer/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend-customer/ ./
RUN npm run build

FROM nginx:alpine

# Static files only: TLS and the routing of /api, /docs, /storage and the
# WebSocket are the Kubernetes Ingress's job, so this image has no certificate
# and proxies nothing.
COPY docker/frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf

COPY --from=admin /app/dist /usr/share/nginx/html
COPY --from=customer /app/dist /usr/share/nginx/html/customer

EXPOSE 80
