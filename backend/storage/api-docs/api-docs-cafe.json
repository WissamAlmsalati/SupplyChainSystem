        "/cafe/orders/{id}/status": {
            "put": {
                "tags": [
                    "Cafe Mobile Orders"
                ],
                "summary": "Confirm order receipt (only after the delegate marks it delivered)",
                "operationId": "766c6aac15f0b1777050785478dff042",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "received"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Receipt confirmed"
                    },
                    "422": {
