    "components": {
        "schemas": {
            "CafeRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "contact_info": {
                        "type": "string",
                        "maxLength": 200,
                        "nullable": true
                    },
                    "created_by_admin_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "CafeBranchRequest": {
                "required": [
                    "cafe_id",
                    "name",
                    "latitude",
                    "longitude"
                ],
                "properties": {
                    "cafe_id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "city": {
                        "type": "string",
                        "maxLength": 100,
                        "nullable": true
                    },
                    "street": {
                        "type": "string",
                        "maxLength": 200,
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "float"
                    },
                    "longitude": {
                        "type": "number",
                        "format": "float"
                    },
                    "delivery_zone_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "DeliveryZoneRequest": {
                "required": [
                    "hex_id",
                    "delivery_price"
                ],
                "properties": {
                    "hex_id": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 100,
                        "nullable": true
                    },
                    "delivery_price": {
                        "type": "number",
                        "format": "float"
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "CategoryRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "parent_category_id": {
                        "type": "integer",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "SupplierRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "contact_info": {
                        "type": "string",
                        "maxLength": 200,
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "ProductRequest": {
                "required": [
                    "category_id",
                    "name"
                ],
                "properties": {
                    "category_id": {
                        "type": "integer"
                    },
                    "supplier_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ProductVariantRequest": {
                "required": [
                    "product_id",
                    "sku",
                    "price"
                ],
                "properties": {
                    "product_id": {
                        "type": "integer"
                    },
                    "sku": {
                        "type": "string",
                        "maxLength": 50
                    },
                    "attribute_name": {
                        "type": "string",
                        "maxLength": 50,
                        "nullable": true
                    },
                    "attribute_value": {
                        "type": "string",
                        "maxLength": 50,
                        "nullable": true
                    },
                    "price": {
                        "type": "number",
                        "format": "float"
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "WarehouseRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "city": {
                        "type": "string",
                        "maxLength": 100,
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "float",
                        "nullable": true
                    },
                    "longitude": {
                        "type": "number",
                        "format": "float",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "InventoryRequest": {
                "required": [
                    "warehouse_id",
                    "product_variant_id",
                    "quantity"
                ],
                "properties": {
                    "warehouse_id": {
                        "type": "integer"
                    },
                    "product_variant_id": {
                        "type": "integer"
                    },
                    "quantity": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "AuthLoginRequest": {
                "description": "Cafe users must login with phone_number and password only. Email is allowed for admin and delegate users only.",
                "required": [
                    "password"
                ],
                "properties": {
                    "email": {
                        "description": "Use for admin/delegate login only. Cafe users must NOT use email.",
                        "type": "string",
                        "format": "email",
                        "nullable": true
                    },
                    "phone_number": {
                        "description": "Required for cafe users. Example: 0912345678",
                        "type": "string",
                        "nullable": true
                    },
                    "password": {
                        "type": "string",
                        "format": "password"
                    }
                },
                "type": "object"
            },
            "AuthRegisterRequest": {
                "required": [
                    "name",
                    "email",
                    "password"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 150
                    },
                    "password": {
                        "type": "string",
