# Laravel's settings on the production server: /opt/cafe-supply-chain/backend/.env.
# scripts/provision-server.sh copies this file and fills in APP_KEY, APP_URL and
# REVERB_APP_SECRET; the rest is yours to complete before the shop goes live.
#
# What is NOT here: APP_ENV, APP_DEBUG, APP_URL, the DB_* credentials, the cache,
# session and queue drivers, TRUSTED_PROXIES. docker-compose.prod.yml sets those
# from the root .env and its `environment:` block wins over this file, so the
# database password has exactly one home and cannot drift out of step.

APP_NAME="الساحل لمستلزمات المقاهي"

# Generated once, never changed: every encrypted column and every signed URL
# is unreadable without the key that wrote it. Keep a copy with the backups.
APP_KEY=

APP_URL=https://cafe.wissam.ly

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug writes every query and every event; on a live shop it fills the disk
# faster than the log rotation clears it.
LOG_LEVEL=warning

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_PASSWORD=null

# Password resets and registration OTPs go out through this. `log` writes them
# to storage/logs instead of sending them, which means nobody can reset a
# password — set real SMTP before opening to customers.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@cafe.wissam.ly"
MAIL_FROM_NAME="${APP_NAME}"

# Regenerating the OpenAPI document on every request is a development
# convenience; in production it is pure latency on /docs.
L5_SWAGGER_GENERATE_ALWAYS=false

# Bearer tokens expire after this many minutes (30 days). The scheduler
# container prunes the expired rows.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Reverb. REVERB_APP_KEY has to stay "local": it is the last segment of the
# path nginx proxies (/app/local) and the key frontend-admin/src/echo.js sends.
# Changing it means changing the nginx template and echo.js with it.
REVERB_APP_ID=local-app
REVERB_APP_KEY=local
REVERB_APP_SECRET=
# Where the PHP app *publishes* events, which is the container next door — not
# where browsers connect. Sending them out through the public edge and back
# would work and be slower, and would break the moment TLS is renewing.
# Browsers reach Reverb at wss://cafe.wissam.ly/app/local; echo.js derives
# that from the page URL, so there is nothing to configure for them.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Clock times people read (order numbers, report headings) use this zone;
# storage stays UTC.
APP_BUSINESS_TIMEZONE=Africa/Tripoli

# Printed on invoices, statements and reports (config/company.php)
COMPANY_NAME="الساحل لمستلزمات المقاهي"
COMPANY_TAGLINE="توريد مستلزمات المقاهي بالجملة"
COMPANY_ADDRESS="طرابلس، ليبيا"
COMPANY_PHONE="091-0000000"
COMPANY_EMAIL="info@cafe.wissam.ly"
COMPANY_COMMERCIAL_REGISTER=
COMPANY_TAX_NUMBER=
