# Docker Compose environment template
# Copy to .env and adjust secrets before running docker compose up.
# This file is commit-safe; real secrets live only in .env (gitignored).

APP_NAME="Cafe Supply Chain"
APP_ENV=local
APP_KEY=base64:XSe/tJfIz/4wVWAtT7KuXnlVxni1kJIjAXIv4GmW4y8=
APP_DEBUG=true
APP_URL=http://localhost

# Trust the Nginx reverse proxy
TRUSTED_PROXIES=**

# Database (MySQL is the default; set DB_CONNECTION=pgsql to use PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cafe_supply_chain
DB_USERNAME=cafe_user
DB_PASSWORD=cafe_pass

# Root password used by the MySQL container healthcheck
DB_ROOT_PASSWORD=root_pass

# Redis (used for cache, sessions, and queues)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail / filesystem / AWS (keep defaults or override as needed)
MAIL_MAILER=log
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost
