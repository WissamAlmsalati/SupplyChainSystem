# Read by docker compose for the production stack (docker-compose.prod.yml).
# On the server this is /opt/cafe-supply-chain/.env, written by
# scripts/provision-server.sh with fresh passwords. It is never in git.
#
# Laravel's own settings are the other file, backend/.env — see
# backend/.env.production.example. The database credentials live here only and
# are pushed into the app containers from here, so the two cannot drift.

# The one hostname the whole platform is served on: admin at /, the customer
# app at /customer/, the API at /api/v1, the WebSocket at /app/local.
DOMAIN=cafe.wissam.ly

# Where Let's Encrypt sends expiry warnings. A real inbox someone reads.
LETSENCRYPT_EMAIL=

# The running release. scripts/deploy.sh rewrites this line on every deploy;
# a reboot then brings back the same release rather than whatever `latest`
# has since become.
IMAGE_TAG=latest

# Override only to deploy from a fork or a different registry.
# BACKEND_IMAGE=ghcr.io/wissamalmsalati/supplychainsystem/backend
# FRONTEND_IMAGE=ghcr.io/wissamalmsalati/supplychainsystem/frontend

# The compose file refuses to start if any of these is unset, so the dev
# defaults (cafe_pass, root_pass) can never reach a machine with a public IP.
DB_DATABASE=cafe_supply_chain
DB_USERNAME=cafe_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
