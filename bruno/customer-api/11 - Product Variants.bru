meta {
  name: Product Variants
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/customer/products/{{productId}}/variants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  const json = res.getBody();
  if (Array.isArray(json.data) && json.data.length > 0) {
    bru.setVar("variantId", json.data[0].id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns variants array", function() {
    const json = res.getBody();
    expect(json.data).to.be.an('array');
    if (json.data.length > 0) {
      expect(json.data[0].id).to.be.a('number');
    }
  });
}
