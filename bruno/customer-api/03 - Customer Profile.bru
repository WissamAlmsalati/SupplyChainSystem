meta {
  name: Customer Profile
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/customer/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns user profile with addresses", function() {
    const json = res.getBody();
    expect(json.user).to.be.an('object');
    expect(json.user.name).to.be.a('string').that.is.not.empty;
    expect(json.addresses).to.be.an('array');
    expect(json).to.not.have.property('has_customer');
  });
}
