meta {
  name: Recurring Cart - Order
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/customer/recurring-carts/{{recurringCartId}}/order
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "address_id": {{addressId}}
  }
}

tests {
  test("status is 201 and order created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data).to.have.property("order_number");
  });
}
