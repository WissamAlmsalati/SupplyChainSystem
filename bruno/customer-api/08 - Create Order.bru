meta {
  name: Create Order
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/customer/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "address_id": {{addressId}},
    "items": [
      {
        "product_variant_id": {{variantId}},
        "quantity": 2
      }
    ]
  }
}

script:post-response {
  const json = res.getBody();
  if (json.data && json.data.id) {
    bru.setVar("createdOrderId", json.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns created order", function() {
    const json = res.getBody();
    expect(json.data.id).to.be.a('number');
    expect(json.data.status).to.equal("pending");
  });
}
