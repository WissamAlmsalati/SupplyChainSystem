meta {
  name: Create Address
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/customer/addresses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "عنوان اختبار",
    "city": "طرابلس",
    "street": "شارع الاختبار",
    "latitude": 27.1,
    "longitude": 17.1,
    "is_active": true,
    "contact_phones": ["0910000001", "0920000002"]
  }
}

script:post-response {
  const json = res.getBody();
  if (json.data && json.data.id) {
    bru.setVar("createdAddressId", json.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns created address", function() {
    const json = res.getBody();
    expect(json.data.id).to.be.a('number');
    expect(json.data.name).to.be.a('string');
  });
}
