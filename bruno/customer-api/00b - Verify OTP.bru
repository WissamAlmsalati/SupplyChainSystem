meta {
  name: Verify Registration OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/customer/verify-otp
  body: json
  auth: none
}

body:json {
  {
    "token": "{{regOtpToken}}",
    "otp": "{{regOtp}}"
  }
}

tests {
  test("status is 200 and resolved either way", function() {
    expect(res.getStatus()).to.equal(200);
    const d = res.getBody().data || res.getBody();
    // customer_auto_approve ON -> "active" with token; OFF -> "pending_approval" message
    expect(["active", "pending_approval"]).to.include(d.status);
    if (d.status === "active") {
      expect(d.token).to.be.a("string");
    } else {
      expect(d.token).to.equal(undefined);
    }
  });
}
