meta {
  name: Orders List
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/customer/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns paginated orders", function() {
    const json = res.getBody();
    expect(json.data).to.be.an('array');
  });
}
