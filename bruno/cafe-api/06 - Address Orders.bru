meta {
  name: Address Orders
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/cafe/addresses/{{addressId}}/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns orders array", function() {
    const json = res.getBody();
    expect(json.data).to.be.an('array');
  });
}
