meta {
  name: Addresses List
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/cafe/addresses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  const json = res.getBody();
  if (Array.isArray(json.data.addresses) && json.data.addresses.length > 0) {
    bru.setVar("addressId", json.data.addresses[0].id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns array of addresses with delivery price", function() {
    const json = res.getBody();
    expect(json.data.addresses).to.be.an('array');
    expect(json.data).to.have.property('delivery_price');
    if (json.data.addresses.length > 0) {
      expect(json.data.addresses[0].id).to.be.a('number');
      expect(json.data.addresses[0]).to.have.property('user_id');
    }
  });
}
