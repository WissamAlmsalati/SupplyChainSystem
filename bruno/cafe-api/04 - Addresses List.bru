meta {
  name: Branches List
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/cafe/branches
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  const json = res.getBody();
  if (Array.isArray(json.data.branches) && json.data.branches.length > 0) {
    bru.setVar("branchId", json.data.branches[0].id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns array of branches with delivery price", function() {
    const json = res.getBody();
    expect(json.data.branches).to.be.an('array');
    expect(json.data).to.have.property('delivery_price');
    if (json.data.branches.length > 0) {
      expect(json.data.branches[0].id).to.be.a('number');
    }
  });
}
