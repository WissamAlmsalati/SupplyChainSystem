meta {
  name: Categories List
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/cafe/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns categories array", function() {
    const json = res.getBody();
    expect(json.data).to.be.an('array');
  });
}
