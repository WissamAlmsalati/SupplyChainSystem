meta {
  name: Cart Flow - Select Branch
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/cafe/cart/branch
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "branch_id": {{branchId}}
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("branch selected", function() {
    expect(res.getBody().data.branch.id).to.equal(Number(bru.getEnvVar("branchId")));
  });
}
