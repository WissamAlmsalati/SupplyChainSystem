        },
        {
            "name": "Cafe Mobile Branches",
            "description": "Cafe mobile app branch management"
        },
        {
            "name": "Cafe Mobile Profile",
            "description": "Cafe mobile app profile"
        },
        {
            "name": "Cafe Mobile Catalog",
            "description": "Cafe mobile app product catalog"
        }
    ],
    "security": [
