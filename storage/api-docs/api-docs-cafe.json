    "components": {
        "schemas": {
            "CafeRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "contact_info": {
                        "type": "string",
                        "maxLength": 200,
                        "nullable": true
                    },
                    "created_by_admin_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "CafeBranchRequest": {
                "required": [
                    "cafe_id",
                    "name",
                    "latitude",
                    "longitude"
                ],
                "properties": {
                    "cafe_id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "city": {
                        "type": "string",
                        "maxLength": 100,
                        "nullable": true
                    },
                    "street": {
                        "type": "string",
                        "maxLength": 200,
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "float"
                    },
                    "longitude": {
                        "type": "number",
                        "format": "float"
                    },
                    "delivery_zone_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "DeliveryZoneRequest": {
                "required": [
                    "hex_id",
                    "delivery_price"
                ],
                "properties": {
                    "hex_id": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 100,
                        "nullable": true
                    },
                    "delivery_price": {
                        "type": "number",
                        "format": "float"
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "CategoryRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "parent_category_id": {
                        "type": "integer",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "SupplierRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "contact_info": {
                        "type": "string",
                        "maxLength": 200,
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "ProductRequest": {
                "required": [
                    "category_id",
                    "name"
                ],
                "properties": {
                    "category_id": {
                        "type": "integer"
                    },
                    "supplier_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ProductVariantRequest": {
                "required": [
                    "product_id",
                    "sku",
                    "price"
                ],
                "properties": {
                    "product_id": {
                        "type": "integer"
                    },
                    "sku": {
                        "type": "string",
                        "maxLength": 50
                    },
                    "attribute_name": {
                        "type": "string",
                        "maxLength": 50,
                        "nullable": true
                    },
                    "attribute_value": {
                        "type": "string",
                        "maxLength": 50,
                        "nullable": true
                    },
                    "price": {
                        "type": "number",
                        "format": "float"
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "WarehouseRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "city": {
                        "type": "string",
                        "maxLength": 100,
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "float",
                        "nullable": true
                    },
                    "longitude": {
                        "type": "number",
                        "format": "float",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "InventoryRequest": {
                "required": [
                    "warehouse_id",
                    "product_variant_id",
                    "quantity"
                ],
                "properties": {
                    "warehouse_id": {
                        "type": "integer"
                    },
                    "product_variant_id": {
                        "type": "integer"
                    },
                    "quantity": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "AuthLoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "format": "password"
                    }
                },
                "type": "object"
            },
            "AuthRegisterRequest": {
                "required": [
                    "name",
                    "email",
                    "password"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 150
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "minLength": 6
                    },
                    "mobile_number": {
                        "type": "string",
                        "maxLength": 20,
                        "nullable": true
                    },
                    "cafe_id": {
                        "type": "integer",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "AuthResponse": {
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "type": "object"
            },
            "AppUserRequest": {
                "required": [
                    "name",
                    "email",
                    "password",
                    "user_type_id"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 150
                    },
                    "mobile_number": {
                        "type": "string",
                        "maxLength": 20,
                        "nullable": true
                    },
                    "password": {
                        "type": "string",
                        "format": "password"
                    },
                    "user_type_id": {
                        "type": "integer"
                    },
                    "cafe_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "OrderItemRequest": {
                "required": [
                    "product_variant_id",
                    "quantity",
                    "unit_price"
                ],
                "properties": {
                    "product_variant_id": {
                        "type": "integer"
                    },
                    "quantity": {
                        "type": "integer"
                    },
                    "unit_price": {
                        "type": "number",
                        "format": "float"
                    }
                },
                "type": "object"
            },
            "OrderRequest": {
                "required": [
                    "user_id",
                    "branch_id",
                    "status",
                    "total_amount"
                ],
                "properties": {
                    "user_id": {
                        "type": "integer"
                    },
                    "branch_id": {
                        "type": "integer"
                    },
                    "delegate_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "delivery_zone_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "delivery_fee": {
                        "type": "number",
                        "format": "float"
                    },
                    "order_date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "total_amount": {
                        "type": "number",
                        "format": "float"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItemRequest"
                        }
                    }
                },
                "type": "object"
            },
            "CafeOrderRequest": {
                "required": [
                    "branch_id",
                    "items"
                ],
                "properties": {
                    "branch_id": {
                        "type": "integer"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItemRequest"
                        }
                    }
                },
                "type": "object"
            },
            "CartRequest": {
                "required": [
                    "user_id",
                    "branch_id"
                ],
                "properties": {
                    "user_id": {
                        "type": "integer"
                    },
                    "branch_id": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "string",
                        "maxLength": 20
                    }
                },
                "type": "object"
            },
            "PurchaseOrderRequest": {
                "required": [
                    "supplier_id",
                    "warehouse_id",
                    "status"
                ],
                "properties": {
                    "supplier_id": {
                        "type": "integer"
                    },
                    "warehouse_id": {
                        "type": "integer"
                    },
                    "order_date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "string",
                        "maxLength": 20
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
